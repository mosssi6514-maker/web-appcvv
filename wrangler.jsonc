{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appcvv",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "52573f9b-cfa0-4852-b8a0-3a0af9e06a2c","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "823158310a844b94b82d0aff17405164" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
